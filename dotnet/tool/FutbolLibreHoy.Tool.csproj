<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>futbol-libre-hoy</ToolCommandName>
    <PackageId>FutbolLibreHoy.Tool</PackageId>
    <Version>1.0.0</Version>
    <Authors>NBK Devs</Authors>
    <Description>CLI for Futbol Libre Hoy - today's football fixtures from verfutbollibre.net</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://verfutbollibre.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nazzal12/ver-futbol-libre-pckgs</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>football;soccer;futbol-libre;cli</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FutbolLibreHoy\FutbolLibreHoy.csproj" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
